#!/bin/bash
# hypr-session-save — snapshot current Hyprland windows into a startup layout.
#
# Records running windows (class, workspace, monitor) into
# ~/.config/hypr/session-layout.tsv and writes ~/.config/hypr/session.conf
# with exec-once launch lines plus a one-shot hypr-session-restore call that
# corrects placement after windows spawn. Launch commands come from
# ~/.config/hypr/session-apps.conf (class = command).
#
# Usage: hypr-session-save

set -euo pipefail

MAP_FILE="$HOME/.config/hypr/session-apps.conf"
OUT_FILE="$HOME/.config/hypr/session.conf"
LAYOUT_FILE="$HOME/.config/hypr/session-layout.tsv"

command -v jq >/dev/null || { echo "error: jq not installed" >&2; exit 1; }
[[ -f $MAP_FILE ]] || { echo "error: $MAP_FILE not found" >&2; exit 1; }

# Load class → command map
declare -A LAUNCH
trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; s="${s%"${s##*[![:space:]]}"}"; printf '%s' "$s"; }
while IFS='=' read -r class cmd; do
  class="$(trim "$class")"
  cmd="$(trim "$cmd")"
  [[ -z $class || $class == \#* ]] && continue
  LAUNCH[$class]=$cmd
done <"$MAP_FILE"

# Monitor id → name map
declare -A MON
while IFS=$'\t' read -r id name; do
  MON[$id]=$name
done < <(hyprctl monitors -j | jq -r '.[] | [.id, .name] | @tsv')

TMP_CONF="$(mktemp)"
TMP_LAYOUT="$(mktemp)"
trap 'rm -f "$TMP_CONF" "$TMP_LAYOUT"' EXIT

{
  echo "# Generated by hypr-session-save on $(date '+%Y-%m-%d %H:%M') — do not edit."
  echo "# Re-run hypr-session-save to overwrite with the current layout."
  echo
} >"$TMP_CONF"

skipped=0
count=0

# Windows sorted by workspace id; skip special/negative workspaces
while IFS=$'\t' read -r class ws mon_id; do
  (( ws < 1 )) && continue
  mon="${MON[$mon_id]:-}"
  if [[ -z ${LAUNCH[$class]:-} ]]; then
    echo "warn: no launch command for class '$class' (ws $ws) — skipped." >&2
    echo "      add it to $MAP_FILE" >&2
    echo "# skipped (no command in session-apps.conf): $class on ws $ws" >>"$TMP_CONF"
    ((skipped += 1))
    continue
  fi
  echo "exec-once = [workspace $ws silent] ${LAUNCH[$class]}" >>"$TMP_CONF"
  printf '%s\t%s\t%s\n' "$class" "$ws" "$mon" >>"$TMP_LAYOUT"
  ((count += 1))
done < <(hyprctl clients -j | jq -r 'sort_by(.workspace.id) | .[] | [.class, .workspace.id, .monitor] | @tsv')

{
  echo
  echo "# One-shot placement fix after apps spawn (spawn rules alone are racy at boot)."
  echo "exec-once = $HOME/.local/bin/hypr-session-restore"
} >>"$TMP_CONF"

mv "$TMP_CONF" "$OUT_FILE"
mv "$TMP_LAYOUT" "$LAYOUT_FILE"
trap - EXIT

echo "saved: $count window(s) → $OUT_FILE (skipped: $skipped)"
hyprctl reload >/dev/null
errors="$(hyprctl configerrors)"
if [[ -n $errors && $errors != "no errors" ]]; then
  echo "warn: hyprctl configerrors reported:" >&2
  echo "$errors" >&2
else
  echo "config reloaded, no errors."
fi
